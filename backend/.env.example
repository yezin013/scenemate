# 이 파일을 복사해서 ".env" 로 저장한 뒤 본인 값으로 채우세요.
# (.env 는 .gitignore 로 깃 제외)

# Supabase → Connect → Session pooler 연결 문자열 ([YOUR-PASSWORD] 자리에 DB 비밀번호 입력)
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# Gemini API 키 (Google AI Studio)
GOOGLE_API_KEY=your-google-api-key-here

# Supabase Auth JWT 시크릿 (Supabase 대시보드 → Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
